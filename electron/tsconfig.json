{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["frontend/src/*"]
    }
  },
  "include": [
    "*.ts",
    "../frontend/src/platform/types.ts",
    "../frontend/src/platform/bridge.ts",
    "../frontend/src/ui/interface-preview/route.ts"
  ]
}
